{ pkgs, ... }: {
  dotenv.enable = true;
  enterShell = ''
    export NPM_CONFIG_PREFIX="$HOME/.npm-global"
    export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"
  '';
  languages.python = {
    enable = true;
    version = "3.12";
    directory = "./backend/";
    uv = {
      enable = true;
      sync.enable = true;
    };
  };
  languages.javascript = {
    enable = true;
    directory = "./ui/";
    pnpm = {
      enable = true;
      install.enable = true;
    };
  };
}
